<?xml version="1.0" encoding="utf-8"?>
<!--
    状态容器样式（Controls/StatePanel）
    ============================================================
    四态叠放在同一层 Grid 中，用 VisualStateManager 切换可见性：
    正常内容永远在底层，加载 / 空 / 错误三层默认折叠。

    约定：本文件只定义样式，数值一律引用 Themes/Tokens.xaml 的令牌。

    注意：ControlTemplate 内部的资源引用统一使用 {ThemeResource}。
    本文件与 Tokens.xaml / Controls.xaml 是并列的合并字典，而 ControlTemplate
    是惰性解析的，{StaticResource} 在那一刻可能查不到兄弟字典；
    {ThemeResource} 在运行时向应用级资源树查找，行为稳定。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WINUI.Controls">

    <!-- 状态提示块的统一最大宽度，避免长句铺满整行难以阅读 -->
    <x:Double x:Key="StatePanelMaxWidth">420</x:Double>
    <x:Double x:Key="StatePanelGlyphSize">40</x:Double>

    <Style x:Key="AppStatePanelStyle" TargetType="controls:StatePanel">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:StatePanel">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="PageStates">
                                <VisualState x:Name="ContentState" />
                                <VisualState x:Name="LoadingState">
                                    <VisualState.Setters>
                                        <Setter Target="StateContent.Visibility" Value="Collapsed" />
                                        <Setter Target="LoadingPanel.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="EmptyState">
                                    <VisualState.Setters>
                                        <Setter Target="StateContent.Visibility" Value="Collapsed" />
                                        <Setter Target="EmptyPanel.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="ErrorState">
                                    <VisualState.Setters>
                                        <Setter Target="StateContent.Visibility" Value="Collapsed" />
                                        <Setter Target="ErrorPanel.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <!-- 正常内容 -->
                        <ContentPresenter
                            x:Name="StateContent"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />

                        <!-- 加载中 -->
                        <StackPanel
                            x:Name="LoadingPanel"
                            MaxWidth="{ThemeResource StatePanelMaxWidth}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="{ThemeResource SpaceMd}"
                            Visibility="Collapsed">
                            <ProgressRing
                                Width="32"
                                Height="32"
                                HorizontalAlignment="Center"
                                IsActive="True" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                TextAlignment="Center"
                                Style="{ThemeResource AppCaptionTextStyle}"
                                Text="{TemplateBinding LoadingText}" />
                        </StackPanel>

                        <!-- 空 -->
                        <StackPanel
                            x:Name="EmptyPanel"
                            MaxWidth="{ThemeResource StatePanelMaxWidth}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="{ThemeResource SpaceSm}"
                            Visibility="Collapsed">
                            <FontIcon
                                HorizontalAlignment="Center"
                                FontFamily="{ThemeResource AppIconFontFamily}"
                                FontSize="{ThemeResource StatePanelGlyphSize}"
                                Foreground="{ThemeResource AppTextTertiaryBrush}"
                                Glyph="{TemplateBinding EmptyGlyph}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{ThemeResource AppSectionTitleStyle}"
                                Text="{TemplateBinding EmptyTitle}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                TextAlignment="Center"
                                Style="{ThemeResource AppCaptionTextStyle}"
                                Text="{TemplateBinding EmptyText}" />
                        </StackPanel>

                        <!-- 错误 -->
                        <StackPanel
                            x:Name="ErrorPanel"
                            MaxWidth="{ThemeResource StatePanelMaxWidth}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="{ThemeResource SpaceSm}"
                            Visibility="Collapsed">
                            <FontIcon
                                HorizontalAlignment="Center"
                                FontFamily="{ThemeResource AppIconFontFamily}"
                                FontSize="{ThemeResource StatePanelGlyphSize}"
                                Foreground="{ThemeResource AppErrorBrush}"
                                Glyph="{TemplateBinding ErrorGlyph}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{ThemeResource AppSectionTitleStyle}"
                                Text="{TemplateBinding ErrorTitle}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                TextAlignment="Center"
                                Style="{ThemeResource AppCaptionTextStyle}"
                                Text="{TemplateBinding ErrorText}" />
                            <Button
                                Margin="0,4,0,0"
                                HorizontalAlignment="Center"
                                Command="{TemplateBinding RetryCommand}"
                                Content="{TemplateBinding RetryText}"
                                Visibility="{TemplateBinding RetryVisibility}" />
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
