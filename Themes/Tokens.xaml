<?xml version="1.0" encoding="utf-8"?>
<!--
    设计令牌（Design Tokens）
    ============================================================
    集中定义颜色、间距、圆角、字号与字体。后续所有自定义控件样式
    都应引用这里的令牌，而不是硬编码数值。

    命名约定：
      Space*            —— 间距（double，用于 StackPanel.Spacing 等）
      PagePadding 等     —— 常用内边距（Thickness）
      Radius*           —— 圆角（CornerRadius）
      FontSize*         —— 字号（double）
      App*Brush         —— 主题相关画笔，在 ThemeDictionaries 中按主题定义
      App*FontFamily    —— 字体

    主题键：Default（深色）/ Light（浅色）/ HighContrast（高对比度）
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== 间距 ==================== -->
    <x:Double x:Key="SpaceXs">4</x:Double>
    <x:Double x:Key="SpaceSm">8</x:Double>
    <x:Double x:Key="SpaceMd">12</x:Double>
    <x:Double x:Key="SpaceLg">16</x:Double>
    <x:Double x:Key="SpaceXl">24</x:Double>
    <x:Double x:Key="SpaceXxl">32</x:Double>

    <!-- ==================== 内边距 ==================== -->
    <Thickness x:Key="PagePadding">24</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="ControlPadding">12,8</Thickness>
    <Thickness x:Key="TitleBarPadding">12,0,0,0</Thickness>

    <!-- ==================== 圆角 ==================== -->
    <CornerRadius x:Key="RadiusSm">4</CornerRadius>
    <CornerRadius x:Key="RadiusMd">8</CornerRadius>
    <CornerRadius x:Key="RadiusLg">12</CornerRadius>
    <CornerRadius x:Key="RadiusXl">16</CornerRadius>

    <!-- ==================== 字号 ==================== -->
    <x:Double x:Key="FontSizeCaption">12</x:Double>
    <x:Double x:Key="FontSizeBody">14</x:Double>
    <x:Double x:Key="FontSizeSubtitle">18</x:Double>
    <x:Double x:Key="FontSizeTitle">24</x:Double>
    <x:Double x:Key="FontSizeDisplay">32</x:Double>
    <x:Double x:Key="FontSizeIcon">16</x:Double>

    <!-- ==================== 字体 ==================== -->
    <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="AppDisplayFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="AppMonoFontFamily">Cascadia Mono, Consolas, Courier New</FontFamily>
    <!-- 图标字体：优先 Segoe Fluent Icons，回退到 Segoe MDL2 Assets -->
    <FontFamily x:Key="AppIconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- ==================== 主题相关画笔 ==================== -->
    <ResourceDictionary.ThemeDictionaries>

        <!-- 深色（默认主题） -->
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF1B1B1F" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FF252529" />
            <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="#FF2E2E33" />
            <SolidColorBrush x:Key="AppDividerBrush" Color="#1FFFFFFF" />

            <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#B3FFFFFF" />
            <SolidColorBrush x:Key="AppTextTertiaryBrush" Color="#80FFFFFF" />

            <SolidColorBrush x:Key="AppAccentBrush" Color="#FF3B82F6" />
            <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#FF5B96F8" />
            <SolidColorBrush x:Key="AppAccentPressedBrush" Color="#FF2A6FDB" />
            <SolidColorBrush x:Key="AppAccentTextBrush" Color="#FFFFFFFF" />

            <SolidColorBrush x:Key="AppSuccessBrush" Color="#FF22C55E" />
            <SolidColorBrush x:Key="AppWarningBrush" Color="#FFF59E0B" />
            <SolidColorBrush x:Key="AppErrorBrush" Color="#FFEF4444" />
        </ResourceDictionary>

        <!-- 浅色 -->
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FFF3F3F5" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="#FFF7F7F9" />
            <SolidColorBrush x:Key="AppDividerBrush" Color="#14000000" />

            <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#FF1A1A1F" />
            <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#99000000" />
            <SolidColorBrush x:Key="AppTextTertiaryBrush" Color="#66000000" />

            <SolidColorBrush x:Key="AppAccentBrush" Color="#FF2563EB" />
            <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#FF1D4FD7" />
            <SolidColorBrush x:Key="AppAccentPressedBrush" Color="#FF1A44B8" />
            <SolidColorBrush x:Key="AppAccentTextBrush" Color="#FFFFFFFF" />

            <SolidColorBrush x:Key="AppSuccessBrush" Color="#FF16A34A" />
            <SolidColorBrush x:Key="AppWarningBrush" Color="#FFD97706" />
            <SolidColorBrush x:Key="AppErrorBrush" Color="#FFDC2626" />
        </ResourceDictionary>

        <!-- 高对比度：使用系统颜色，保证可访问性 -->
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="AppDividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />

            <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AppTextTertiaryBrush" Color="{ThemeResource SystemColorGrayTextColor}" />

            <SolidColorBrush x:Key="AppAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AppAccentHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AppAccentPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AppAccentTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />

            <SolidColorBrush x:Key="AppSuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AppWarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AppErrorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
