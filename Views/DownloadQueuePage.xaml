<?xml version="1.0" encoding="utf-8"?>
<!--
    下载队列（二级页，大更新 ⑧-4）：
    右上角「下载中 N」入口进入。任务由全局队列服务持有，页面离开不中断、
    重进恢复状态。每任务提供 取消 / 重试 / 移除 与完成引导（启动游戏 / 查看实例）。
-->
<Page
    x:Class="WINUI.Views.DownloadQueuePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:WINUI.ViewModels"
    xmlns:controls="using:WINUI.Controls"
    mc:Ignorable="d">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="{StaticResource SpaceLg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 页头：返回 + 标题 + 徽章 -->
        <Grid Grid.Row="0" ColumnSpacing="{StaticResource SpaceMd}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.GoBackCommand}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                    <FontIcon
                        FontFamily="{StaticResource AppIconFontFamily}"
                        FontSize="14"
                        Glyph="{StaticResource IconBackGlyph}" />
                    <TextBlock VerticalAlignment="Center" Text="返回" />
                </StackPanel>
            </Button>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="{StaticResource SpaceXs}">
                <TextBlock Style="{StaticResource AppPageTitleStyle}" Text="下载队列" />
                <TextBlock Style="{StaticResource AppCaptionTextStyle}" Text="{x:Bind ViewModel.QueueSummary, Mode=OneWay}" />
            </StackPanel>

            <Button
                Grid.Column="2"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.ClearFinishedCommand}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                    <FontIcon
                        FontFamily="{StaticResource AppIconFontFamily}"
                        FontSize="14"
                        Glyph="{StaticResource IconDeleteGlyph}" />
                    <TextBlock VerticalAlignment="Center" Text="清空已完成" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- 整体进度（有任务时显示） -->
        <StackPanel Grid.Row="1" Spacing="{StaticResource SpaceXs}">
            <Grid ColumnSpacing="{StaticResource SpaceMd}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar
                    Grid.Column="0"
                    Maximum="100"
                    Value="{x:Bind ViewModel.OverallProgress, Mode=OneWay}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource AppCaptionTextStyle}"
                    Text="{x:Bind ViewModel.BadgeLabel, Mode=OneWay}" />
            </Grid>
        </StackPanel>

        <!-- 任务列表 -->
        <controls:StatePanel
            Grid.Row="2"
            EmptyGlyph="{x:Bind ViewModel.EmptyGlyph, Mode=OneWay}"
            EmptyText="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
            EmptyTitle="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}"
            State="{x:Bind ViewModel.State, Mode=OneWay}"
            Style="{StaticResource AppStatePanelStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Tasks}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="{StaticResource SpaceSm}" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:DownloadTaskViewModel">
                            <Border Style="{StaticResource AppCardStyle}">
                                <Grid ColumnSpacing="{StaticResource SpaceMd}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="{StaticResource SpaceXs}">
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                Style="{StaticResource AppBodyTextStyle}"
                                                Text="{x:Bind Name, Mode=OneWay}" />
                                            <Border Style="{StaticResource AppBadgeStyle}">
                                                <TextBlock Style="{StaticResource AppBadgeTextStyle}" Text="{x:Bind CategoryLabel, Mode=OneWay}" />
                                            </Border>
                                            <Border Style="{StaticResource AppBadgeStyle}">
                                                <TextBlock Style="{StaticResource AppBadgeTextStyle}" Text="{x:Bind StatusLabel, Mode=OneWay}" />
                                            </Border>
                                            <Border Style="{StaticResource AppBadgeStyle}" Visibility="{x:Bind IsDemo}">
                                                <TextBlock Style="{StaticResource AppBadgeTextStyle}" Text="演示" />
                                            </Border>
                                        </StackPanel>

                                        <!-- 进度条：不可知时为不确定进度 -->
                                        <ProgressBar
                                            IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                                            Maximum="100"
                                            Value="{x:Bind Progress, Mode=OneWay}" />

                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                                            <TextBlock Style="{StaticResource AppCaptionTextStyle}" Text="{x:Bind SizeLabel, Mode=OneWay}" />
                                            <TextBlock Style="{StaticResource AppCaptionTextStyle}" Text="·" />
                                            <TextBlock Style="{StaticResource AppCaptionTextStyle}" Text="{x:Bind SpeedLabel, Mode=OneWay}" />
                                            <TextBlock Style="{StaticResource AppCaptionTextStyle}" Text="·" />
                                            <TextBlock Style="{StaticResource AppCaptionTextStyle}" Text="{x:Bind RemainingLabel, Mode=OneWay}" />
                                            <TextBlock
                                                Margin="8,0,0,0"
                                                Style="{StaticResource AppCaptionTextStyle}"
                                                Text="{x:Bind InstanceLabel, Mode=OneWay}"
                                                Visibility="{x:Bind ShowLaunchActions, Mode=OneWay}" />
                                        </StackPanel>

                                        <!-- 重试 / 错误信息 -->
                                        <TextBlock
                                            Style="{StaticResource AppCaptionTextStyle}"
                                            Foreground="{ThemeResource AppCautionBrush}"
                                            Text="{x:Bind RetryNote, Mode=OneWay}"
                                            Visibility="{x:Bind HasRetryNote, Mode=OneWay}" />
                                        <TextBlock
                                            Style="{StaticResource AppCaptionTextStyle}"
                                            Foreground="{ThemeResource AppDangerBrush}"
                                            Text="{x:Bind ErrorMessage, Mode=OneWay}"
                                            Visibility="{x:Bind HasError, Mode=OneWay}" />

                                        <!-- 完成引导 -->
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="{StaticResource SpaceSm}"
                                            Visibility="{x:Bind ShowLaunchActions, Mode=OneWay}">
                                            <Button
                                                Padding="14,6"
                                                Click="OnLaunchClick"
                                                Style="{StaticResource AppAccentButtonStyle}"
                                                Tag="{x:Bind}">
                                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                                                    <FontIcon
                                                        FontFamily="{StaticResource AppIconFontFamily}"
                                                        FontSize="14"
                                                        Glyph="{StaticResource IconPlayGlyph}" />
                                                    <TextBlock Text="启动游戏" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                Padding="14,6"
                                                Click="OnViewInstancesClick"
                                                Tag="{x:Bind}">
                                                <TextBlock Text="查看实例" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 操作 -->
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="{StaticResource SpaceSm}">
                                        <Button
                                            Padding="10,5"
                                            Click="OnCancelClick"
                                            Content="取消"
                                            Tag="{x:Bind}"
                                            Visibility="{x:Bind CanCancel, Mode=OneWay}" />
                                        <Button
                                            Padding="10,5"
                                            Click="OnRetryClick"
                                            Content="重试"
                                            Tag="{x:Bind}"
                                            Visibility="{x:Bind CanRetry, Mode=OneWay}" />
                                        <Button
                                            Padding="10,5"
                                            Click="OnRemoveClick"
                                            Content="移除"
                                            Tag="{x:Bind}"
                                            Visibility="{x:Bind CanRemove, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </controls:StatePanel>

        <!-- 状态栏 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
            <Ellipse
                Width="8"
                Height="8"
                VerticalAlignment="Center"
                Fill="{ThemeResource AppAccentBrush}" />
            <TextBlock Style="{StaticResource AppCaptionTextStyle}" Text="下载在后台进行，离开本页不会中断；取消任务会保留已下载的文件。" />
        </StackPanel>
    </Grid>
</Page>
