<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WINUI.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Minecraft 启动器">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="{StaticResource SpaceSm}">
            <TextBlock
                HorizontalAlignment="Center"
                FontFamily="{StaticResource AppDisplayFontFamily}"
                FontSize="{StaticResource FontSizeDisplay}"
                FontWeight="SemiBold"
                Foreground="{ThemeResource AppTextPrimaryBrush}"
                Text="{x:Bind ViewModel.AppTitle, Mode=OneWay}" />
            <TextBlock
                HorizontalAlignment="Center"
                FontFamily="{StaticResource AppFontFamily}"
                FontSize="{StaticResource FontSizeBody}"
                Foreground="{ThemeResource AppTextSecondaryBrush}"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</Window>
