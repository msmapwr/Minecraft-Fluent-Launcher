<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WINUI.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:WINUI.Controls"
    mc:Ignorable="d"
    Title="Minecraft Fluent Launcher">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <VisualStateManager.VisualStateGroups>
            <!--
                外壳三档（按窗口宽度）：
                ≥1000   侧栏完整展开
                640–999 侧栏折叠成图标栏
                <640    极简汉堡（点开后覆盖内容）
                约定：命中范围小的状态写在前，最后一个命中者生效。
            -->
            <VisualStateGroup x:Name="ShellStates">
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ShellNavigation.PaneDisplayMode" Value="LeftMinimal" />
                        <Setter Target="ShellNavigation.IsPaneOpen" Value="False" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="MediumState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="640" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ShellNavigation.PaneDisplayMode" Value="LeftCompact" />
                        <Setter Target="ShellNavigation.IsPaneOpen" Value="False" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ShellNavigation.PaneDisplayMode" Value="Left" />
                        <Setter Target="ShellNavigation.IsPaneOpen" Value="True" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自定义标题栏：左侧为图标与标题，右侧为下载入口，最右留给系统窗口按钮 -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="40"
            Padding="{StaticResource TitleBarPadding}">
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="{StaticResource SpaceSm}">
                <Image
                    Width="20"
                    Height="20"
                    VerticalAlignment="Center"
                    Source="ms-appx:///Assets/AppIcon.png" />
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource AppSectionTitleStyle}"
                    Text="{x:Bind ViewModel.AppTitle, Mode=OneWay}" />
            </StackPanel>

            <!-- 全局下载入口（大更新 ⑧-4）：有任务时显示「下载中 N」+ 进度环 -->
            <Button
                x:Name="DownloadBadgeButton"
                Padding="10,4"
                Height="32"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,148,0"
                Click="OnDownloadBadgeClick">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                    <ProgressRing
                        Width="14"
                        Height="14"
                        IsActive="{x:Bind ViewModel.HasActiveDownloads, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasActiveDownloads, Mode=OneWay}"
                        Value="{x:Bind ViewModel.DownloadOverallProgress, Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource AppCaptionTextStyle}"
                        Text="{x:Bind ViewModel.DownloadBadgeLabel, Mode=OneWay}" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- 应用外壳：左侧导航 + 内容 Frame。各 NavigationViewItem 的 Tag 即路由键。 -->
        <NavigationView
            x:Name="ShellNavigation"
            Grid.Row="1"
            AlwaysShowHeader="False"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="True"
            IsSettingsVisible="False"
            ItemInvoked="OnNavigationItemInvoked"
            OpenPaneLength="220"
            PaneDisplayMode="Left">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="启动" Tag="launch">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource AppIconFontFamily}" Glyph="{StaticResource IconPlayGlyph}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="实例" Tag="instances">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource AppIconFontFamily}" Glyph="{StaticResource IconLibraryGlyph}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="下载" Tag="downloads">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource AppIconFontFamily}" Glyph="{StaticResource IconDownloadGlyph}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="模组" Tag="mods">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource AppIconFontFamily}" Glyph="{StaticResource IconListGlyph}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="账户" Tag="accounts">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource AppIconFontFamily}" Glyph="{StaticResource IconAccountGlyph}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="设置" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource AppIconFontFamily}" Glyph="{StaticResource IconSettingsGlyph}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="日志" Tag="logs">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource AppIconFontFamily}" Glyph="{StaticResource IconLogGlyph}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="关于" Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource AppIconFontFamily}" Glyph="{StaticResource IconInfoGlyph}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <ComboBox
                    Margin="8,4,8,12"
                    HorizontalAlignment="Stretch"
                    DisplayMemberPath="DisplayName"
                    Header="主题"
                    ItemsSource="{x:Bind ViewModel.ThemeOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedThemeOption, Mode=TwoWay}" />
            </NavigationView.PaneFooter>

            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <!--
            通知宿主：右下角的一叠 InfoBar。
            放在 NavigationView 之后，因此在 Z 序上位于页面内容之上。
            控件本身不画背景，空白处不拦截鼠标事件。
        -->
        <controls:NotificationHost
            x:Name="NotificationArea"
            Grid.Row="1"
            Margin="0,0,20,44"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            MinWidth="300"
            MaxWidth="420" />
    </Grid>
</Window>
