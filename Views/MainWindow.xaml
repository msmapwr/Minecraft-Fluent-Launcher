<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WINUI.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Minecraft 启动器">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- 设计系统预览面：将在「应用外壳」阶段被导航框架替换 -->
    <Grid>
        <Border
            Margin="{StaticResource SpaceXl}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource AppCardStyle}">
            <StackPanel MaxWidth="420" Spacing="{StaticResource SpaceMd}">
                <TextBlock
                    Style="{StaticResource AppPageTitleStyle}"
                    Text="{x:Bind ViewModel.AppTitle, Mode=OneWay}" />
                <TextBlock
                    Style="{StaticResource AppBodyTextStyle}"
                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                <TextBlock
                    Style="{StaticResource AppCaptionTextStyle}"
                    Text="设计系统预览 · 应用外壳将在后续阶段替换本页" />
                <Button
                    HorizontalAlignment="Left"
                    Command="{x:Bind ViewModel.PreviewCommand}"
                    Content="预览主按钮"
                    Style="{StaticResource AppAccentButtonStyle}" />
            </StackPanel>
        </Border>

        <ComboBox
            Margin="{StaticResource PagePadding}"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            DisplayMemberPath="DisplayName"
            Header="主题"
            ItemsSource="{x:Bind ViewModel.ThemeOptions}"
            SelectedItem="{x:Bind ViewModel.SelectedThemeOption, Mode=TwoWay}" />
    </Grid>
</Window>
