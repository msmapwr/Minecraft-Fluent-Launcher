<?xml version="1.0" encoding="utf-8"?>
<!--
    安装确认对话框（大更新 ⑧-2 / ⑧-5）。
    按条目类别切换内容：
      版本     → 加载器单选 + 实例名 + 安装位置（真实安装）
      模组     → 目标版本 + 加载器 + 兼容性预判（演示）
      整合包   → 依赖摘要 + 新实例名（演示）
      其它类型 → 目标实例（演示）
    结果通过 Result 属性交给调用方。
-->
<ContentDialog
    x:Class="WINUI.Views.InstallConfirmDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:WINUI.ViewModels"
    mc:Ignorable="d"
    Title="安装"
    PrimaryButtonText="开始安装"
    CloseButtonText="取消"
    DefaultButton="Primary">

    <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
        <StackPanel Spacing="{StaticResource SpaceMd}" MinWidth="360">

            <!-- 条目摘要 -->
            <StackPanel Spacing="{StaticResource SpaceXs}">
                <TextBlock
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource AppTextPrimaryBrush}"
                    Style="{StaticResource AppBodyTextStyle}"
                    Text="{x:Bind ItemName}" />
                <TextBlock Style="{StaticResource AppCaptionTextStyle}" Text="{x:Bind ItemSubtitle}" />
            </StackPanel>

            <!-- 版本模式：加载器单选 -->
            <StackPanel x:Name="VersionModePanel" Spacing="{StaticResource SpaceSm}" Visibility="Collapsed">
                <TextBlock Style="{StaticResource AppBodyTextStyle}" Text="选择模组加载器" />
                <RadioButtons
                    x:Name="LoaderChoiceList"
                    ItemsSource="{x:Bind LoaderChoices}"
                    SelectionChanged="OnLoaderSelectionChanged">
                    <RadioButtons.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:LoaderChoiceViewModel">
                            <StackPanel Spacing="2" Margin="0,2">
                                <TextBlock Style="{StaticResource AppBodyTextStyle}" Text="{x:Bind DisplayName}" />
                                <TextBlock Style="{StaticResource AppCaptionTextStyle}" Text="{x:Bind Detail}" />
                            </StackPanel>
                        </DataTemplate>
                    </RadioButtons.ItemTemplate>
                </RadioButtons>
                <InfoBar
                    x:Name="LoaderNotice"
                    IsOpen="False"
                    IsClosable="False"
                    Severity="Informational"
                    Message="该加载器的自动安装将在 v0.3 支持，本次将先安装原版。" />
            </StackPanel>

            <!-- 模组模式：目标版本 + 加载器 + 兼容性 -->
            <StackPanel x:Name="ModModePanel" Spacing="{StaticResource SpaceSm}" Visibility="Collapsed">
                <ComboBox
                    x:Name="ModTargetVersionBox"
                    HorizontalAlignment="Stretch"
                    Header="目标游戏版本"
                    DisplayMemberPath="DisplayName"
                    SelectionChanged="OnModSelectionChanged" />
                <ComboBox
                    x:Name="ModLoaderBox"
                    HorizontalAlignment="Stretch"
                    Header="所需加载器"
                    DisplayMemberPath="DisplayName"
                    SelectionChanged="OnModSelectionChanged" />
                <InfoBar
                    x:Name="CompatBar"
                    IsOpen="False"
                    IsClosable="False"
                    Severity="Warning"
                    Title="可能不兼容"
                    Message="所选游戏版本与该模组标注的适用范围不一致。" />
            </StackPanel>

            <!-- 整合包模式：依赖摘要 -->
            <InfoBar
                x:Name="ModpackBar"
                IsOpen="False"
                IsClosable="False"
                Severity="Informational"
                Title="将自动安装依赖"
                Message="整合包所需的版本与加载器会一并下载，并生成一个独立实例。" />

            <!-- 通用：实例 -->
            <TextBox
                x:Name="InstanceNameBox"
                Header="实例名称"
                PlaceholderText="例如：1.21.4 · Fabric"
                TextChanged="OnInstanceNameChanged" />

            <!-- 通用（模组等）：目标实例 -->
            <ComboBox
                x:Name="TargetInstanceBox"
                HorizontalAlignment="Stretch"
                Header="安装到实例"
                DisplayMemberPath="Name"
                Visibility="Collapsed" />

            <!-- 安装位置（仅真实安装的版本条目） -->
            <StackPanel x:Name="LocationPanel" Spacing="{StaticResource SpaceXs}" Visibility="Collapsed">
                <TextBlock Style="{StaticResource AppBodyTextStyle}" Text="安装位置" />
                <TextBlock
                    Style="{StaticResource AppCaptionTextStyle}"
                    Foreground="{ThemeResource AppTextSecondaryBrush}"
                    TextWrapping="Wrap"
                    Text="{x:Bind LocationText}" />
            </StackPanel>

            <!-- 演示标注（资源站接入 v0.3 前的非版本条目） -->
            <InfoBar
                x:Name="DemoBar"
                IsOpen="False"
                IsClosable="False"
                Severity="Warning"
                Title="演示模式"
                Message="资源站接入（v0.3）前，此安装仅模拟进度，不会下载文件。" />

            <!-- 安装摘要 -->
            <TextBlock
                x:Name="SummaryTextBlock"
                Style="{StaticResource AppCaptionTextStyle}"
                Foreground="{ThemeResource AppTextSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
