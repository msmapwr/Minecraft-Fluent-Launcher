<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WINUI.Views.AccountsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="{StaticResource PagePadding}">
        <StackPanel Spacing="{StaticResource SpaceSm}">
            <TextBlock Style="{StaticResource AppPageTitleStyle}" Text="账户" />
            <TextBlock Style="{StaticResource AppBodyTextStyle}" Text="管理离线账号与微软账号。" />
            <TextBlock Style="{StaticResource AppCaptionTextStyle}" Text="占位页 · 将在「核心页面」阶段实现" />
        </StackPanel>
    </Grid>
</Page>
