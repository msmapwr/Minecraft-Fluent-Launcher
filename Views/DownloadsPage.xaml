<?xml version="1.0" encoding="utf-8"?>
<!--
    下载中心（大更新 ⑧ 重构）：
    资源类型一级入口（默认 Minecraft）→ 类型内浏览（搜索 / 下载源 / 真实安装状态）
    → 「安装」弹确认对话框 → 任务进入全局下载队列（右上角入口 / 本页摘要条可跳转）。
-->
<Page
    x:Class="WINUI.Views.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WINUI.Models"
    xmlns:viewmodels="using:WINUI.ViewModels"
    xmlns:controls="using:WINUI.Controls"
    mc:Ignorable="d">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="{StaticResource SpaceLg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Spacing="{StaticResource SpaceXs}">
            <TextBlock Style="{StaticResource AppPageTitleStyle}" Text="下载中心" />
            <TextBlock Style="{StaticResource AppBodyTextStyle}" Text="先选想玩的内容，确认后由启动器在后台准备；完成后可直接启动游戏。" />
        </StackPanel>

        <!-- 资源类型一级入口 -->
        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Hidden"
            HorizontalScrollMode="Auto"
            VerticalScrollMode="Disabled">
            <ItemsControl ItemsSource="{x:Bind ViewModel.CategoryCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:CategoryCardViewModel">
                        <Grid MinWidth="180">
                            <!-- 非当前项 -->
                            <Button
                                Padding="14,10"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Click="OnCategoryCardClick"
                                Tag="{x:Bind}"
                                Visibility="{x:Bind IsNotCurrent}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource AppIconFontFamily}"
                                        FontSize="16"
                                        Glyph="{x:Bind Glyph}" />
                                    <StackPanel Spacing="1">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource AppTextPrimaryBrush}"
                                            Style="{StaticResource AppBodyTextStyle}"
                                            Text="{x:Bind DisplayName}" />
                                        <TextBlock Style="{StaticResource AppCaptionTextStyle}" Text="{x:Bind Description}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <!-- 当前项 -->
                            <Button
                                Padding="14,10"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Click="OnCategoryCardClick"
                                Style="{StaticResource AppAccentButtonStyle}"
                                Tag="{x:Bind}"
                                Visibility="{x:Bind IsCurrent}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource AppIconFontFamily}"
                                        FontSize="16"
                                        Glyph="{x:Bind Glyph}" />
                                    <StackPanel Spacing="1">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Style="{StaticResource AppBodyTextStyle}"
                                            Text="{x:Bind DisplayName}" />
                                        <TextBlock Style="{StaticResource AppCaptionTextStyle}" Text="{x:Bind Description}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 工具栏 -->
        <Grid Grid.Row="2" ColumnSpacing="{StaticResource SpaceMd}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox
                Grid.Column="0"
                MaxWidth="340"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Header="搜索"
                PlaceholderText="名称、作者或简介"
                QueryIcon="Find"
                Text="{x:Bind ViewModel.SearchText, Mode=OneWay}"
                TextChanged="OnSearchBoxTextChanged" />
            <ComboBox
                Grid.Column="1"
                MinWidth="160"
                VerticalAlignment="Bottom"
                DisplayMemberPath="DisplayName"
                Header="下载源"
                ItemsSource="{x:Bind ViewModel.Sources}"
                SelectedItem="{x:Bind ViewModel.SelectedSource, Mode=TwoWay}" />
            <Button
                Grid.Column="2"
                VerticalAlignment="Bottom"
                Command="{x:Bind ViewModel.ReloadCommand}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                    <FontIcon
                        FontFamily="{StaticResource AppIconFontFamily}"
                        FontSize="14"
                        Glyph="{StaticResource IconRefreshGlyph}" />
                    <TextBlock VerticalAlignment="Center" Text="刷新" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- 条目列表：四态（加载 / 内容 / 空 / 错误）统一由 StatePanel 承担 -->
        <controls:StatePanel
            Grid.Row="3"
            EmptyGlyph="{x:Bind ViewModel.EmptyGlyph, Mode=OneWay}"
            EmptyText="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
            EmptyTitle="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}"
            ErrorText="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            RetryCommand="{x:Bind ViewModel.ReloadCommand}"
            State="{x:Bind ViewModel.State, Mode=OneWay}"
            Style="{StaticResource AppStatePanelStyle}">
            <Grid RowSpacing="{StaticResource SpaceSm}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 队列摘要条：有进行中的任务时出现，点击进入下载队列 -->
                <Button
                    Grid.Row="0"
                    Padding="10,6"
                    HorizontalAlignment="Right"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.OpenQueueCommand}"
                    Visibility="{x:Bind ViewModel.IsDownloadActive, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                        <ProgressRing
                            Width="16"
                            Height="16"
                            IsActive="True" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource AppCaptionTextStyle}"
                            Text="{x:Bind ViewModel.DownloadSummary, Mode=OneWay}" />
                        <FontIcon
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource AppIconFontFamily}"
                            FontSize="12"
                            Glyph="{StaticResource IconChevronRightGlyph}" />
                    </StackPanel>
                </Button>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Items}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="{StaticResource SpaceSm}" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:DownloadItemViewModel">
                                <Border Style="{StaticResource AppCardStyle}">
                                    <Grid ColumnSpacing="{StaticResource SpaceMd}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="{StaticResource SpaceXs}">
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                    Style="{StaticResource AppBodyTextStyle}"
                                                    Text="{x:Bind Name}" />
                                                <Border Style="{StaticResource AppBadgeStyle}">
                                                    <TextBlock Style="{StaticResource AppBadgeTextStyle}" Text="{x:Bind CategoryLabel}" />
                                                </Border>
                                                <!-- 安装中 -->
                                                <Border Style="{StaticResource AppBadgeStyle}" Visibility="{x:Bind IsInstalling}">
                                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
                                                        <ProgressRing
                                                            Width="10"
                                                            Height="10"
                                                            VerticalAlignment="Center"
                                                            IsActive="True" />
                                                        <TextBlock Style="{StaticResource AppBadgeTextStyle}" Text="{x:Bind InstallStateLabel}" />
                                                    </StackPanel>
                                                </Border>
                                                <!-- 已安装 -->
                                                <Border Style="{StaticResource AppBadgeStyle}" Visibility="{x:Bind IsInstalled}">
                                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
                                                        <Ellipse
                                                            Width="8"
                                                            Height="8"
                                                            VerticalAlignment="Center"
                                                            Fill="{ThemeResource AppSuccessBrush}" />
                                                        <TextBlock Style="{StaticResource AppBadgeTextStyle}" Text="{x:Bind InstallStateLabel}" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Style="{StaticResource AppCaptionTextStyle}" Text="{x:Bind Description}" />

                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                                                <TextBlock Style="{StaticResource AppCaptionTextStyle}" Text="{x:Bind Author}" />
                                                <TextBlock Style="{StaticResource AppCaptionTextStyle}" Text="·" />
                                                <TextBlock Style="{StaticResource AppCaptionTextStyle}" Text="{x:Bind Version}" />
                                                <TextBlock Style="{StaticResource AppCaptionTextStyle}" Text="·" />
                                                <TextBlock Style="{StaticResource AppCaptionTextStyle}" Text="{x:Bind SizeLabel}" />
                                                <TextBlock Style="{StaticResource AppCaptionTextStyle}" Text="·" />
                                                <TextBlock Style="{StaticResource AppCaptionTextStyle}" Text="{x:Bind DownloadCountLabel}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="{StaticResource SpaceSm}">

                                            <!-- 版本条目：进入详情页 -->
                                            <Button
                                                Padding="16,8"
                                                Click="OnDetailClick"
                                                Tag="{x:Bind}"
                                                Visibility="{x:Bind IsVersion}">
                                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                                                    <FontIcon
                                                        FontFamily="{StaticResource AppIconFontFamily}"
                                                        FontSize="14"
                                                        Glyph="{StaticResource IconChevronRightGlyph}" />
                                                    <TextBlock VerticalAlignment="Center" Text="查看" />
                                                </StackPanel>
                                            </Button>

                                            <!-- 安装：未安装时可用 -->
                                            <Button
                                                Padding="16,8"
                                                Click="OnInstallClick"
                                                Style="{StaticResource AppAccentButtonStyle}"
                                                Tag="{x:Bind}"
                                                Visibility="{x:Bind IsNotInstalled}">
                                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                                                    <FontIcon
                                                        FontFamily="{StaticResource AppIconFontFamily}"
                                                        FontSize="14"
                                                        Glyph="{StaticResource IconDownloadGlyph}" />
                                                    <TextBlock VerticalAlignment="Center" Text="安装" />
                                                </StackPanel>
                                            </Button>

                                            <!-- 已安装（禁用态，与安装按钮同位） -->
                                            <Button
                                                Padding="16,8"
                                                IsEnabled="False"
                                                Visibility="{x:Bind IsInstalled}">
                                                <TextBlock Text="已安装" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>
            </Grid>
        </controls:StatePanel>

        <!-- 分页 -->
        <Grid Grid.Row="4" ColumnSpacing="{StaticResource SpaceMd}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox
                Grid.Column="0"
                MinWidth="140"
                VerticalAlignment="Bottom"
                DisplayMemberPath="DisplayName"
                Header="每页条数"
                ItemsSource="{x:Bind ViewModel.PageSizes}"
                SelectedItem="{x:Bind ViewModel.SelectedPageSize, Mode=TwoWay}" />

            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Orientation="Horizontal"
                Spacing="{StaticResource SpaceXs}"
                Visibility="{x:Bind ViewModel.ShowPager, Mode=OneWay}">
                <Button
                    Padding="10,5"
                    Command="{x:Bind ViewModel.FirstPageCommand}"
                    Content="首页"
                    FontSize="{StaticResource FontSizeCaption}" />
                <Button
                    Padding="10,5"
                    Command="{x:Bind ViewModel.PreviousPageCommand}"
                    Content="上一页"
                    FontSize="{StaticResource FontSizeCaption}" />

                <ItemsControl ItemsSource="{x:Bind ViewModel.PageButtons}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:PageButtonViewModel">
                            <Grid>
                                <Button
                                    MinWidth="36"
                                    Padding="8,5"
                                    Click="OnPageClick"
                                    Content="{x:Bind Label}"
                                    FontSize="{StaticResource FontSizeCaption}"
                                    Tag="{x:Bind Number}"
                                    Visibility="{x:Bind IsNotCurrent, Mode=OneWay}" />
                                <Button
                                    MinWidth="36"
                                    Padding="8,5"
                                    Click="OnPageClick"
                                    Content="{x:Bind Label}"
                                    FontSize="{StaticResource FontSizeCaption}"
                                    Style="{StaticResource AppAccentButtonStyle}"
                                    Tag="{x:Bind Number}"
                                    Visibility="{x:Bind IsCurrent, Mode=OneWay}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button
                    Padding="10,5"
                    Command="{x:Bind ViewModel.NextPageCommand}"
                    Content="下一页"
                    FontSize="{StaticResource FontSizeCaption}" />
                <Button
                    Padding="10,5"
                    Command="{x:Bind ViewModel.LastPageCommand}"
                    Content="末页"
                    FontSize="{StaticResource FontSizeCaption}" />
            </StackPanel>

            <TextBlock
                Grid.Column="2"
                VerticalAlignment="Bottom"
                Style="{StaticResource AppCaptionTextStyle}"
                Text="{x:Bind ViewModel.PageSummary, Mode=OneWay}" />
        </Grid>

        <!-- 状态栏 -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
            <Ellipse
                Width="8"
                Height="8"
                VerticalAlignment="Center"
                Fill="{ThemeResource AppAccentBrush}" />
            <TextBlock Style="{StaticResource AppCaptionTextStyle}" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</Page>
